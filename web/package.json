{
  "name": "vendalytics-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Vendalytics — plataforma de inteligência de vendas, geomarketing e enriquecimento B2B. React + Stitches.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
