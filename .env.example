# Vendalytics — copie para .env e preencha. Nenhum valor real deste arquivo
# de exemplo — tudo vazio/placeholder de propósito.

# Segredo de assinatura do JWT — OBRIGATÓRIO, sem valor padrão no código.
# Gere um novo com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Fonte de dados ativa: sqlite_reference (padrão, roda sem nenhuma dependência
# externa) | postgres (a implementar quando um cliente precisar).
VENDALYTICS_ADAPTER=sqlite_reference

# Só usado pelo adapter sqlite_reference — caminho do arquivo local.
VENDALYTICS_SQLITE_PATH=./vendalytics_demo.sqlite

# Caminho do arquivo de identidade/branding deste tenant (copie de
# config/tenant_config.example.yaml e ajuste para o cliente).
VENDALYTICS_TENANT_CONFIG=./config/tenant_config.yaml

# IA (opcional — recursos de assistente/briefing ficam desligados sem isso).
GROQ_API_KEY=

# WhatsApp via Whapi.cloud (opcional — módulo de CRM/bot fica desligado sem isso).
WHAPI_TOKEN=
WHAPI_WEBHOOK_SECRET=


# Modo demo: liga respostas fictícias em módulos que chamariam API externa
# paga (ex.: busca de CNPJ), evitando gastar cota real numa demonstração.
DEMO_MODE=true
