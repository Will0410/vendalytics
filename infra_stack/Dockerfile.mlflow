# Dockerfile.mlflow — não existe imagem oficial de um comando só; isto é o
# suficiente para validar tracking server real (spec §3.3). Sem backend
# store em Postgres nem artifact store em S3 — é o degrau de dev, não de
# produção (documentado, não escondido).
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir mlflow==2.14.1
EXPOSE 5000
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--default-artifact-root", "/mlflow/artifacts"]
